# --- Data mode -------------------------------------------------------------
# mock = seeded sample data served by this app (default). live = real n8n webhooks.
NEXT_PUBLIC_DATA_MODE=mock

# --- n8n (server-side only, never exposed to the browser) -------------------
# Base URL of the n8n instance, no trailing slash. Webhooks are called at
# {N8N_BASE_URL}/webhook/re/<path>  (use /webhook-test/ while testing via the editor)
N8N_BASE_URL=https://your-instance.app.n8n.cloud
N8N_WEBHOOK_AUTH_HEADER_NAME=X-RE-Key
N8N_WEBHOOK_AUTH_VALUE=change-me
# Only used by tooling that reads the n8n Public API (never by the app at runtime)
N8N_API_KEY=

# --- Login & session -----------------------------------------------------
OWNER_PASSWORD=change-me-owner
# Agents sign in with their phone number (last 10 digits) + this shared seed, e.g. "9811100001:agent-seed"
# For a stronger setup, replace with per-agent passwords in your own user store.
AGENT_LOGIN_SEED=change-me-agent
# 32+ random characters used to sign the httpOnly session cookie
SESSION_SECRET=replace-with-at-least-32-random-characters

# "production" calls /webhook/re/... ; "test" calls /webhook-test/re/... (n8n editor test URLs, while the
# workflow is open in the editor with "Listen for test event" on)
N8N_WEBHOOK_MODE=production
